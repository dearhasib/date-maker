# Optional instant response notifications.
#
# These are build-time Vite variables. They are bundled into the public client
# JavaScript, so never put a truly secret token here. Use a dedicated Discord
# webhook or a domain-restricted Web3Forms key that you can rotate.
#
# Leave both blank to keep the app client-only and notification-free.

# Paste the webhook URL copied from your private Discord channel:
VITE_DISCORD_WEBHOOK_URL=

# Web3Forms access key from https://web3forms.com/:
VITE_WEB3FORMS_KEY=
